# Шаблон змінних оточення. Скопіюйте в .env і підставте свої значення:  cp .env.example .env

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
# True — режим розробки (Debug Toolbar, детальні помилки). У production: False.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- База даних ---
# postgres — PostgreSQL, sqlite — локальний db.sqlite3 без Docker
DB_ENGINE=postgres
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=change-me
# У docker-compose host/port перевизначаються на db:5432 автоматично.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (кеш і сесії) ---
# У docker-compose перевизначається на redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- Gunicorn ---
GUNICORN_WORKERS=3

# --- Автоматичні дії при старті контейнера (docker-entrypoint.sh) ---
# 1 — створити групи "Бібліотекарі"/"Клієнти" (команда setup_groups)
SETUP_GROUPS=1
# Автоматичне створення суперкористувача при старті (якщо ще немає).
# Розкоментуйте для чистого старту. НЕ вмикайте, якщо переносите дані зі SQLite:
# ваш адмін приїде разом з дампом.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me
